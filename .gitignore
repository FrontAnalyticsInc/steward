# Environment variables containing secrets
.env

# MkDocs build output — regenerated by `mkdocs build` and baked into the docs
# image at build time, so it is never committed.
site/
.venv-docs/

# Python cache and build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.venv-*/
env/
venv/
.uv-cache/

# Operating system files
.DS_Store
Thumbs.db

# Docker / Compose overrides
docker-compose.override.yml
*.local.yml

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Runtime integration-call records, written by the workflows container at run
# time and mounted from the host. Test runs that bind-mount workflows/ into the
# image write here too, which is how one of these got committed once.
workflows/adk-state/

# Claude Code's per-session scratch space. `worktrees/` holds a full checkout
# per concurrent session — 1.4 GB on this host when it was first noticed — and
# each one is a registered git worktree of THIS repo, so committing it would
# nest copies of the repo inside itself. Session-local by definition: nothing in
# here describes the deployment.
.claude/

# Terraform: provider binaries and local state. The lock file IS committed —
# it pins provider versions so every apply resolves the same ones.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
