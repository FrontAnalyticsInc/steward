# ==============================================================================
# Hermes Infrastructure Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Models
# ------------------------------------------------------------------------------
# Hermes and the ADK workflows both call Anthropic directly — Hermes through its
# own native adapter, the workflows through the LiteLLM SDK in-process. There is
# no proxy container: the LiteLLM proxy's own floor is 4 CPU / 8 GB with a
# Postgres beside it, which is more machine than the entire rest of this stack.
#
# WHICH model runs is still one file, just not a proxy config. The workflows read
# ${HERMES_DATA_DIR}/config/model-aliases.yaml (seeded by hermes/seed.sh) and ask
# for a role — drafting, extraction, fast — never a model string. Hermes's own
# models are in its config.yaml, editable from the operator console.
#
# One key, read by hermes-gateway, hermes-dashboard and workflows. It is a
# billable credential: keep it here, never inline in config.yaml, which lives in
# HERMES_DATA_DIR and gets backed up.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Refuse to dispatch a workflow once the day's model spend passes this, in USD.
# 0 disables the check. Replaces the per-key budgets the proxy would have
# enforced; the invoker checks it before every run and refuses rather than
# aborting mid-run, so a workflow is never killed with half its side effects done.
#
# Covers WORKFLOWS ONLY — Hermes chat and cron call Anthropic directly and never
# appear in this ledger. The real ceiling for the host is the spend limit on the
# Anthropic account. Two different guarantees, and this is the weaker one.
WORKFLOWS_DAILY_COST_CAP_USD=10

# Where the workflows read the alias map. Set only if you mount it elsewhere.
# MODEL_ALIASES_PATH=/code/config/model-aliases.yaml

# Which alias a workflow gets when it asks for no particular one.
# WORKFLOWS_DEFAULT_ALIAS=drafting

# ------------------------------------------------------------------------------
# Wiki memory
# ------------------------------------------------------------------------------
# What the workflows remember about people and organisations: one markdown file
# per entity, keyed on an Attio record id or an email address, with a derived
# SQLite FTS5 index beside it.
#
# This replaced Neo4j + Graphiti. Nothing here needs a service, a credential or
# a port — the store is files, and the index rebuilds from them if deleted.
# Defaults to ${HERMES_DATA_DIR}/wiki; set this only to put it elsewhere.
# HERMES_WIKI_DIR=/srv/hermes-data/wiki

# ------------------------------------------------------------------------------
# Hermes Agent Configuration
# ------------------------------------------------------------------------------
HERMES_UID=1000
HERMES_GID=1000

# ------------------------------------------------------------------------------
# Hermes Basic Authentication (Dashboard Login)
# ------------------------------------------------------------------------------
# These override whatever credentials are saved in your config.yaml.
# Change "password" to any secure value you wish to use for LAN login.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=your_dashboard_password_here
HERMES_DASHBOARD_BASIC_AUTH_SECRET=generate_with_openssl_rand_base64_32

# ------------------------------------------------------------------------------
# Gateway API key
# ------------------------------------------------------------------------------
# REQUIRED. The gateway refuses to start its API server without it, which is the
# behaviour you want — the operator console and every scheduled job authenticate
# with this, so an unauthenticated gateway would be one anything on the host
# could drive.
#
# It used to carry a compose default of `some_long_secure_secret_key_here`. That
# was removed deliberately: a published placeholder is a published credential,
# and a stack that boots with one looks configured while being wide open. Now an
# unset value stops the gateway instead of hiding in it.
#
#     openssl rand -hex 32
API_SERVER_KEY=

# ------------------------------------------------------------------------------
# Deployment paths (portability)
# ------------------------------------------------------------------------------
# Where Hermes keeps its runtime state: sessions, kanban board, cron jobs,
# memories, credentials. Seeded on first run by hermes/seed.sh from the
# versioned material in hermes/. Defaults to ~/.hermes so an existing install
# keeps working untouched; point it anywhere for a fresh deployment.
# HERMES_DATA_DIR=/srv/hermes-data

# The review queue. Producers write pending/ here, the dashboard writes
# approved/ and rejected/ on a human keystroke, and review-executor works
# through executing/ -> executed/ or failed/. All six live under this one path.
# APPROVALS_DIR=/srv/approvals

# ------------------------------------------------------------------------------
# Review queue
# ------------------------------------------------------------------------------
# Origins allowed to POST a review decision. Approving an item now creates a
# draft or sends mail as the human, so this is a real control rather than a
# development convenience — a page on any other origin must not be able to
# trigger it. Add the address you actually open the dashboard on.
# DASHBOARD_ALLOWED_ORIGINS=http://localhost:9120,http://192.168.1.10:9120

# Which review actions this deployment can perform, as capability names. Unset
# means the verified default (gmail_modify,gmail_send_as_principal); empty means
# none, which leaves every action visible but disabled with its reason shown.
#
# gmail_settings_basic is deliberately absent: the writer service account has no
# domain-wide delegation for gmail.settings.basic, so creating a standing Gmail
# filter is not possible. Grant the scope in the Workspace admin console and add
# the name here to enable it.
# REVIEW_CAPABILITIES=gmail_modify,gmail_send_as_principal

# Sending AS THE HUMAN, for items a human approved. Separate from MAILER_*
# below, which sends as the assistant unattended: two identities, two audit-log
# sources, and only this one is reachable from the review queue. Uses the same
# writer service account, delegated for gmail.send across the domain, with the
# subject chosen at runtime.
# PRINCIPAL_MAILER_SERVICE_ACCOUNT_FILE=/secrets/GOOGLE_WORKSPACE_SERVICE_ACCOUNT_WRITER.json
# PRINCIPAL_MAILER_SENDER=you@yourdomain.com

# How often the executor sweeps approved/, and how long a claimed item may sit
# in executing/ before it is reported as stalled. A stalled item is never
# retried automatically — a stall around a send cannot be distinguished from a
# send that succeeded.
# REVIEW_EXECUTOR_POLL=10
# REVIEW_EXECUTION_LEASE=600

# ------------------------------------------------------------------------------
# ADK workflows service
# ------------------------------------------------------------------------------
# Models come from Anthropic by default; nothing here needs setting. Which one
# answers each role is model-aliases.yaml, above.
#
# The `ollama` provider remains for local development against a host GPU, but it
# is no longer simply a matter of setting the variable: every service is on a
# bridge now, and a container cannot reach an Ollama bound to the host's
# 127.0.0.1. Bind Ollama somewhere a container can reach and point
# OLLAMA_API_BASE at that address.
# WORKFLOWS_MODEL_PROVIDER=ollama
# WORKFLOWS_OLLAMA_MODEL=gemma4:12b-it-qat-64k
# OLLAMA_API_BASE=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
# Every service is on one internal bridge and resolves the others by service
# name. What reaches the HOST is only what is published below, and everything is
# published to loopback — so on a cloud box, reach it over Tailscale rather than
# opening a port.
#
# The operator console is the one you may want on a LAN address. It has NO
# AUTHENTICATION and it holds the gateway's API key, so anything that can reach
# it can act as the agent. Change this only for a network you control.
# DASHBOARD_BIND=127.0.0.1
# LIGHT_DASHBOARD_PORT=9120
# HERMES_UI_PORT=9119
# HERMES_GATEWAY_PORT=8642
# WORKFLOWS_PORT=8020

# ------------------------------------------------------------------------------
# Telemetry — there is none, and nothing to configure
# ------------------------------------------------------------------------------
# No trace store, no collector, and no exporter endpoint set on any service.
# Two stores in succession and the collector in front of them were each removed:
# nothing in this repo read the traces, and a receiver with no backend only
# batches spans and drops them.
#
# What a run did is recorded regardless, as one JSON line per run under
# ${HERMES_DATA_DIR}/adk/traces/. The console reads those directly with DuckDB.
# That is the observability this stack actually has, and it needs no service.
#
# Every setting that lived here went with the containers. Git history has all of
# it if telemetry is ever put back; the shape to restore is a collector service
# plus OTEL_EXPORTER_OTLP_ENDPOINT on `workflows`, pointed at the collector
# rather than at a store.
#
# One thing to keep if you do: bind it to loopback. Spans carry prompt and
# response text.

# ------------------------------------------------------------------------------
# Documentation site
# ------------------------------------------------------------------------------
# Bound to all interfaces by default so the docs are readable from another
# machine on the network. This is the one service here whose content is public
# anyway; set DOCS_BIND=127.0.0.1 to restrict it to the host.
# DOCS_BIND=0.0.0.0
# DOCS_PORT=9121

# ------------------------------------------------------------------------------
# Headless browser (browserless/chromium)
# ------------------------------------------------------------------------------
# Renders client-side apps so ingest workflows can read them. Needed for any
# target that ships an empty shell and builds the page in JS — kestrel.io serves
# byte-identical HTML at every route without it.
#
# BROWSER_TOKEN is a REAL credential, not a formality, and it is REQUIRED. This
# service fetches any URL it is given and executes that page's JavaScript, from
# inside the stack's network where it can reach every other service by name.
#
# Unset, the renderer now answers 503 to everything and its healthcheck fails.
# That is deliberate: it previously treated an empty token as "no auth
# configured" and served every request, so a forgotten variable produced an open
# proxy that looked perfectly healthy. Misconfigured is now visibly down.
#     openssl rand -hex 24
BROWSER_TOKEN=
#
# 3010 rather than 3000, which is already in use on this host.
# BROWSER_PORT=3010
# BROWSER_CONCURRENT=2
# BROWSER_TIMEOUT_MS=60000
#
# Extensions load from ${HERMES_DATA_DIR}/browser/extensions — one UNPACKED
# directory each, with manifest.json at its top level. A packed .crx will not
# work: Chrome removed command-line side-loading of packed extensions, which is
# also why this runs Playwright's bundled Chromium rather than stock Chrome.
#
# The profile at ${HERMES_DATA_DIR}/browser/profile persists between restarts,
# so a logged-in session survives. That directory then holds live session
# cookies — treat it as a credential store, not a cache.
#
# Both must exist and be owned by the user running compose BEFORE first start.
# Docker creates a missing bind source as root, and the browser does not run as
# root, so it would fail to write its profile with a permissions error that does
# not name the cause:
#     mkdir -p ~/.hermes/browser/extensions ~/.hermes/browser/profile

# Optional: only needed if a workflow points at a real Obsidian vault.
# OBSIDIAN_VAULT_PATH=/srv/vault
