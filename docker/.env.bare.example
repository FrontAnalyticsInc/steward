# ==============================================================================
# Steward — bare install
# ==============================================================================
#
# The variable set for a Steward install that runs on models alone: no Gmail, no
# Calendar, no Attio, no page rendering. install.sh writes this file
# with the generated values filled in; it is published as `.env.example` on each
# release so anyone can see what the installer produced and why.
#
# This is deliberately NOT docker/.env.example, which stays as the full internal
# reference for a development host. The difference is the point: every variable
# absent here is one an operator does not have to reason about, and every
# integration absent here is one that cannot half-work. Adding Gmail or Attio
# later means adding their variables from the full reference, and granting the
# access those variables imply.
#
# Everything marked GENERATED is per-install and must not be copied between
# machines. Everything marked SECRET belongs in a file mode 0600 and nowhere else.

# ------------------------------------------------------------------------------
# Release pinning
# ------------------------------------------------------------------------------
# The one line that makes two installs identical. `latest` moves; a tag does not,
# so a tester reporting a bug and a developer reproducing it are looking at the
# same bits. install.sh writes the version it was asked for.
IMAGE_TAG=v0.1.0
GITHUB_REPOSITORY=frontanalyticsinc/hermes-infra

# The docker network name. Named explicitly so two stacks on one host — a test
# install beside a working one — cannot adopt each other's containers.
COMPOSE_NETWORK_NAME=steward_net

# ------------------------------------------------------------------------------
# Where state lives
# ------------------------------------------------------------------------------
# Where the stack itself is installed on the host — the stack file, the .env you
# are reading, the snapshots an upgrade takes, and the `hermes-update` runner.
# install.sh writes whatever it was given with --home.
#
# The console reads this one variable for a single purpose: printing the upgrade
# command in Settings -> About. It cannot run that command — it has no docker
# socket, on purpose — so getting this wrong shows a wrong path, nothing worse.
STEWARD_HOME=/srv/steward

# HERMES_DATA_DIR is the whole of the deployment's state: config, databases, the
# wiki, the agent's memories. On a cloud box it must be on the DATA disk, not the
# boot disk — replacing a VM keeps one and destroys the other.
#
# The approvals queue defaults inside it for that same reason. It used to default
# elsewhere, which meant rebuilding a VM silently discarded every item a human
# had been asked to approve.
HERMES_DATA_DIR=/srv/steward/data
APPROVALS_DIR=/srv/steward/data/approvals

# Mounted read-only at /secrets. Empty on a bare install, and it must still
# EXIST: docker creates a missing bind source as a root-owned directory, and the
# container that then cannot read it reports no reason.
GMAIL_SECRETS_DIR=/srv/steward/data/secrets

# The user that owns the data directory. Every service is given the same pair, so
# a mismatch here shows up as a gateway that cannot read its own config.
# install.sh writes `id -u` and `id -g`.
HERMES_UID=1000
HERMES_GID=1000

# ------------------------------------------------------------------------------
# Models — the one credential you bring
# ------------------------------------------------------------------------------
# SECRET. Read directly from the environment by the model provider, by all three
# of hermes-gateway, hermes-dashboard and workflows. There is no interactive
# login step on this path and no auth.json to manage.
#
# Keep it here rather than in config.yaml: config.yaml lives in HERMES_DATA_DIR
# and gets backed up, and a backup is a place a billable credential should never
# reach.
ANTHROPIC_API_KEY=

WORKFLOWS_MODEL_PROVIDER=anthropic

# Refuse to dispatch a workflow once the day's model spend passes this, in USD.
# 0 disables it. Checked before a run starts, so a workflow is never killed with
# half its side effects done. Covers WORKFLOWS ONLY — chat and cron call the API
# directly and never appear in this ledger. The real ceiling is the spend limit
# on your Anthropic account; this is the weaker of the two guarantees.
WORKFLOWS_DAILY_COST_CAP_USD=10

# ------------------------------------------------------------------------------
# Secrets — GENERATED per install
# ------------------------------------------------------------------------------
# SECRET. The gateway's bearer token. The gateway refuses to start if it is
# empty, which is deliberate: a published placeholder is a published credential.
# The same value must reach hermes-gateway, hermes-dashboard and light-dashboard
# — desyncing them breaks the console in a way that looks like a network fault.
API_SERVER_KEY=

# SECRET. Console login. The dashboard auth plugin reads these ahead of
# config.yaml and hashes the plaintext in memory, so nothing needs to be hashed
# here and config.yaml's basic_auth block stays empty.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ------------------------------------------------------------------------------
# Exposure
# ------------------------------------------------------------------------------
# Loopback, and it should stay loopback.
#
# The operator console has NO AUTHENTICATION of its own beyond the basic-auth
# above, and it holds API_SERVER_KEY — anything that can reach it can act as the
# agent. Reach it from another machine with an SSH tunnel, or on a tailnet with
# `tailscale serve --bg 9120`, which terminates TLS and needs no inbound firewall
# rule. Do not answer "I can't reach the console" by setting this to 0.0.0.0.
DASHBOARD_BIND=127.0.0.1
DOCS_BIND=127.0.0.1

# Write routes on the console check this. A hostname missing from the list gets a
# 403 with no visible explanation — if you add a tailnet or LAN address above,
# add the matching origin here or the approve buttons silently stop working.
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:9120,http://localhost:9120

# ------------------------------------------------------------------------------
# Deliberately empty
# ------------------------------------------------------------------------------
# Both of these have compose defaults that are WRONG for a bare install, which is
# why they are set empty rather than omitted.
#
# REVIEW_CAPABILITIES defaults to `gmail_modify,gmail_send_as_principal`. Leaving
# it unset advertises to the review executor that this install can modify and
# send mail as its principal. It cannot — there are no credentials for it — so
# unset means approved items queue up against an ability that does not exist.
REVIEW_CAPABILITIES=

# BROWSER_URL defaults to http://browser:3010, a service the bare stack does not
# start (it is behind `--profile browser`, and its image is 3.7 GB). Empty is a
# supported state that workflows are required to treat as "rendering
# unavailable": they fail on the first fetch instead of returning nothing and
# calling it an answer. Turn the profile on and clear this line together, never
# one without the other.
BROWSER_URL=
