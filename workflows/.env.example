# Local development configuration. Copy to .env and fill in.
# .env is gitignored — never commit real values.
#
# This project is LOCAL ONLY. It does not deploy to GCP and does not use
# Application Default Credentials.

# --- Model provider -------------------------------------------------------
# anthropic is the default and the only provider a deployed stack uses; it needs
# ANTHROPIC_API_KEY. See app/config.py, which agrees.
#
# ollama and gemini remain as local-development branches only. Neither is used
# in a deployment, and choosing ollama here means this host also has to run
# Ollama with the model pulled and bound somewhere a bridged container can
# reach — 127.0.0.1 is the container, not the host.
WORKFLOWS_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Ollama (local development only, when WORKFLOWS_MODEL_PROVIDER=ollama).
# WORKFLOWS_OLLAMA_MODEL=gemma4:12b-it-qat-64k
# OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Gemini (optional) ----------------------------------------------------
# Set WORKFLOWS_MODEL_PROVIDER=gemini and supply a key to switch providers with
# no code change. A free Google AI Studio key is sufficient for evals.
GEMINI_API_KEY=
WORKFLOWS_GEMINI_MODEL=gemini-3.6-flash

# --- Telemetry ------------------------------------------------------------
# ADK exports OTLP automatically when this is set. Compose points it at the
# OpenTelemetry Collector (127.0.0.1:4318), never at a trace store directly —
# the collector is what decides where spans land. Leave blank to disable
# tracing entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hermes-workflows

# Cloud Trace/Logging require ADC and are off by default. Do not enable locally.
OTEL_TO_CLOUD=false

# --- Vertex AI (unused locally) -------------------------------------------
# Left documented but blank. Setting GOOGLE_GENAI_USE_VERTEXAI=true makes the
# stack expect ADC, which this project deliberately does not configure.
# GOOGLE_GENAI_USE_VERTEXAI=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
